# The default Compose only starts the Web container. Choose the database that
# the server owner already provides. Percent-encode reserved URL characters.
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://siyuan_web:replace-me@postgres.example.com:5432/siyuan_web
# MySQL alternative:
# DATABASE_TYPE=mysql
# DATABASE_URL=mysql://siyuan_web:replace-me@mysql.example.com:3306/siyuan_web
SIYUAN_WEB_API_KEY=replace-with-at-least-32-random-characters
SIYUAN_WEB_ADMIN_USER=admin
SIYUAN_WEB_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
SIYUAN_WEB_SESSION_SECURE=true
SIYUAN_WEB_SESSION_TTL_HOURS=12
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
CORS_ORIGINS=https://menu.example.com
TRUST_PROXY=1
DB_SSL=true
DB_SSL_VERIFY=true

# Optional OpenAI-compatible AI drafts. Keep disabled until all values below are set.
SIYUAN_AI_ENABLED=false
SIYUAN_AI_BASE_URL=https://api.openai.com/v1
SIYUAN_AI_API_KEY=
SIYUAN_AI_MODEL=
SIYUAN_AI_TIMEOUT_MS=20000
SIYUAN_AI_MAX_PROMPT_CHARS=2000
SIYUAN_AI_MAX_TOKENS=1200
SIYUAN_AI_RATE_LIMIT_PER_MINUTE=6
